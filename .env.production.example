# Скопируйте в .env на сервере: cp .env.production.example .env
# и заполните значения. Файл .env в git не попадает.

# Домен сайта. Пусто или не задано -> сайт работает по http://IP-сервера
DOMAIN=

# Пароль базы PostgreSQL. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=

# Секрет для подписи JWT-токенов входа. Сгенерировать: openssl rand -hex 32
JWT_SECRET_KEY=

# Ключ Groq API (https://console.groq.com/keys). Только здесь, нигде больше.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Дополнительные разрешённые origin для CORS через запятую (обычно не нужно,
# т.к. фронтенд и API на одном домене).
CORS_ORIGINS=
